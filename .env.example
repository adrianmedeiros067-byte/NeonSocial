# Desenvolvimento local. No Docker, o compose sobrescreve DB_HOST e REDIS_HOST.
SECRET_KEY=generate-a-random-secret-key
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=neonsocial_db
DB_USER=neon_user
DB_PASS=change-me
DB_HOST=localhost
DB_PORT=5432
CONN_MAX_AGE=60
# Throttle anônimo: nº de proxies confiáveis à frente do app (0 = acesso direto). Vazio = padrão do DRF (usa X-Forwarded-For inteiro).
NUM_PROXIES=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
JWT_SECRET=generate-a-second-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@neonsocial.local
FRONTEND_URL=http://localhost:3000
MAX_UPLOAD_SIZE_MB=50
PAYMENT_WEBHOOK_SECRET=
